{
  "name": "md2docx",
  "version": "1.1.0",
  "description": "Desktop Markdown to Word (.docx) / PDF converter, powered by Pandoc and Typst.",
  "main": "src/main.js",
  "author": "Arif Febriana <febrianaarif7@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ariffebriana.md2docx",
    "productName": "MD2DOCX",
    "copyright": "Copyright Â© 2025 Arif Febriana",
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/pandoc",
        "to": "pandoc"
      },
      {
        "from": "vendor/typst",
        "to": "typst"
      },
      {
        "from": "assets/reference.docx",
        "to": "reference.docx"
      },
      {
        "from": "assets/toc-pagebreak.lua",
        "to": "filters/toc-pagebreak.lua"
      },
      {
        "from": "assets/pagebreak.xml",
        "to": "pagebreak.xml"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MD2DOCX"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Office"
    }
  },
  "dependencies": {
    "@opendocsg/pdf2md": "^0.2.7"
  }
}
